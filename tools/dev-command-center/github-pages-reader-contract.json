{
  "schema_version": 1,
  "system_id": "monster-rpg-dev-command-center",
  "phase": 15,
  "status": "pages_reader_ready",
  "source": {
    "service": "GitHub Pages REST API",
    "base_url": "https://api.github.com",
    "repository_default": "kankidoi2-byte/monster-rpg-ver8"
  },
  "transport": {
    "methods": [
      "GET"
    ],
    "redirects": "rejected",
    "max_response_characters": 1000000,
    "endpoints": [
      "/repos/{owner}/{repository}/pages",
      "/repos/{owner}/{repository}/pages/builds/latest"
    ]
  },
  "permissions": [
    "pages:read"
  ],
  "authentication": {
    "token_environment": "DEV_COMMAND_CENTER_GITHUB_TOKEN",
    "token_optional_for_public_repository": true,
    "token_returned": false,
    "token_logged": false,
    "secret_value_in_repository": false
  },
  "output": {
    "site": [
      "status",
      "url",
      "build_type",
      "source.branch",
      "source.path",
      "public",
      "https_enforced"
    ],
    "latest_build": [
      "status",
      "published_sha",
      "created_at",
      "published_at",
      "duration_ms",
      "has_error"
    ],
    "partial_failure": true,
    "fixed_reason_codes": true
  },
  "privacy": {
    "retained": [
      "公開URL",
      "公開状態",
      "公開対象SHA",
      "公開時刻",
      "ビルド所要時間",
      "公開元ブランチとパス"
    ],
    "discarded": [
      "pusher情報",
      "エラー本文",
      "レスポンス生データ",
      "CNAME",
      "証明書情報",
      "認証情報"
    ]
  },
  "forbidden_operations": [
    "Pagesサイト設定変更",
    "Pagesビルド要求",
    "Pagesデプロイ作成",
    "Pagesデプロイ取消",
    "公開設定変更",
    "権限自動拡大",
    "ゲームクライアントへの組み込み"
  ],
  "manual_verification_required": false
}
